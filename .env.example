# .env.example → .env 로 복사 후 값 입력 (로컬 실행용). .env는 git에 올라가지 않습니다.

# [필수] 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 '사용함'으로 했다면 입력
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 등록한 값과 동일하게
KAKAO_REDIRECT_URI=https://localhost
# (선택) GitHub Actions처럼 토큰 파일이 없는 환경에서 사용
KAKAO_REFRESH_TOKEN=

# [cafe_api 모드 + 회원 전용 게시판] 네이버 로그인 쿠키
NAVER_NID_AUT=
NAVER_NID_SES=

# [search_api 모드] 네이버 개발자센터 애플리케이션 (검색 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
